# Banco de dados (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fintrack
# DATABASE_URL tem precedência sobre os componentes; senha na URL deve ser percent-encoded.
# Sem URL, POSTGRES_PASSWORD aceita caracteres especiais sem escape.
DATABASE_URL=
# Local descartável: disable explícito. Externo: verify-full e CA montada em runtime.
DATABASE_SSLMODE=disable
DATABASE_SSLROOTCERT=
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10
DATABASE_READY_TIMEOUT=3
PORT=8000

# Autenticação (JWT)
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_KEY=replace-with-a-long-random-admin-key
FRONTEND_ORIGINS=http://localhost:3000

# brapi: somente no backend. Preencha no .env local ou no ambiente do servidor.
BRAPI_TOKEN=
# Padrões do plano Gratuito: 1 ticker/chamada, 1 chamada simultânea, delay ~30 min.
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_CACHE_TTL_SECONDS=1800
PRICE_CACHE_MAX_ENTRIES=1000
PRICE_HTTP_MAX_CONCURRENCY=1
PRICE_BATCH_SIZE=1
