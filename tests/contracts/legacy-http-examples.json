        "method": "GET",
        "path": "/assets"
      },
      "response": {
        "status_code": 401,
        "json": {
          "detail": "Not authenticated"
        }
      }
    },
    {
      "name": "registration",
      "request": {
        "method": "POST",
        "path": "/auth/register",
        "json": {
          "user_name": "baseline_user",
          "password": "synthetic-baseline-password"
        }
      },
      "response": {
        "status_code": 200,
        "json": {
          "user_id": "bd1c67a5-1f83-4929-8796-908ec76a5f69",
          "user_name": "baseline_user"
        }
      }
    },
    {
      "name": "duplicate_user",
      "request": {
        "method": "POST",
        "path": "/auth/register",
        "json": {
          "user_name": "baseline_user",
          "password": "synthetic-baseline-password"
        }
      },
      "response": {
        "status_code": 409,
        "json": {
          "detail": "Nome de usuário já está em uso"
