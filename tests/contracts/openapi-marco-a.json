  "components": {
    "schemas": {
      "AdminAssetItem": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "cdb",
              "government_bond",
              "national_stock",
              "international_stock",
              "real_estate_fund",
              "cryptocurrency"
            ],
            "title": "Type"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "current_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Current Price"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          },
          "maturity_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maturity Date"
          },
          "fgc_covered": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fgc Covered"
          },
          "liquidity_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LiquidityType"
              },
              {
                "type": "null"
              }
            ]
          },
          "index_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IndexType"
              },
              {
                "type": "null"
              }
            ]
          },
          "bond_index_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BondIndexType"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "type",
          "name",
          "ticker",
          "current_price"
        ],
        "title": "AdminAssetItem"
      },
      "AdminAssetUpsertRequest": {
        "properties": {
          "assets": {
            "items": {
              "$ref": "#/components/schemas/AdminAssetItem"
            },
            "type": "array",
            "title": "Assets"
          }
        },
        "type": "object",
        "required": [
          "assets"
        ],
        "title": "AdminAssetUpsertRequest"
      },
      "AssetBaseRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "current_price": {
            "type": "string",
            "title": "Current Price"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "ticker",
          "current_price"
        ],
        "title": "AssetBaseRead"
      },
      "AssetCatalogRead": {
        "properties": {
          "id": {
            "type": "string",
