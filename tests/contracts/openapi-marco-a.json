            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "current_price": {
            "type": "string",
            "title": "Current Price"
          },
          "asset_type": {
            "type": "string",
            "title": "Asset Type"
          },
          "rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          },
          "maturity_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maturity Date"
          },
          "fgc_covered": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fgc Covered"
          },
          "liquidity_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LiquidityType"
              },
              {
                "type": "null"
              }
            ]
          },
          "index_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IndexType"
              },
              {
                "type": "null"
              }
            ]
          },
          "bond_index_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BondIndexType"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "ticker",
          "current_price",
          "asset_type"
        ],
        "title": "AssetCatalogRead"
      },
      "BondIndexType": {
        "type": "string",
        "enum": [
          "selic",
          "ipca",
          "prefixado"
        ],
        "title": "BondIndexType",
        "description": "Index types specific to government bonds."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IndexType": {
        "type": "string",
        "enum": [
          "cdi",
          "ipca",
          "prefixado"
        ],
        "title": "IndexType",
        "description": "Index types for fixed income assets."
      },
      "LiquidityType": {
        "type": "string",
        "enum": [
          "diaria",
          "no_vencimento",
          "periodica"
        ],
        "title": "LiquidityType",
        "description": "Liquidity classifications for fixed income assets."
      },
      "PortfolioRead": {
        "properties": {
          "id_portfolio": {
            "type": "string",
            "format": "uuid",
            "title": "Id Portfolio"
          }
        },
        "type": "object",
        "required": [
          "id_portfolio"
        ],
        "title": "PortfolioRead"
      },
      "PortfolioSummaryRead": {
        "properties": {
          "total_cost": {
            "type": "string",
            "title": "Total Cost"
          },
          "total_equity": {
            "type": "string",
            "title": "Total Equity"
          },
          "total_pnl": {
            "type": "string",
            "title": "Total Pnl"
          },
          "return_percentage": {
            "type": "string",
