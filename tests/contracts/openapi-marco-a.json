      },
      "PositionRead": {
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/AssetCatalogRead"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity"
          },
          "average_price": {
            "type": "string",
            "title": "Average Price"
          },
          "current_price": {
            "type": "string",
            "title": "Current Price"
          },
          "cost_basis": {
            "type": "string",
            "title": "Cost Basis"
          },
          "market_value": {
            "type": "string",
            "title": "Market Value"
          },
          "pnl": {
            "type": "string",
            "title": "Pnl"
          },
          "return_percentage": {
            "type": "string",
            "title": "Return Percentage"
          }
        },
        "type": "object",
        "required": [
          "asset",
          "quantity",
          "average_price",
          "current_price",
          "cost_basis",
          "market_value",
          "pnl",
          "return_percentage"
        ],
        "title": "PositionRead"
      },
      "TokenRead": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenRead"
      },
      "TransactionCreate": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Price"
          },
          "transaction_date": {
            "type": "string",
            "format": "date",
            "title": "Transaction Date"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "quantity",
          "price",
          "transaction_date"
        ],
        "title": "TransactionCreate"
      },
      "TransactionRead": {
        "properties": {
          "id_transaction": {
            "type": "string",
            "format": "uuid",
            "title": "Id Transaction"
          },
          "asset": {
            "$ref": "#/components/schemas/AssetBaseRead"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity"
          },
          "price": {
            "type": "string",
            "title": "Price"
          },
          "transaction_type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "transaction_date": {
            "type": "string",
            "format": "date",
            "title": "Transaction Date"
          }
        },
        "type": "object",
        "required": [
          "id_transaction",
          "asset",
          "quantity",
          "price",
          "transaction_type",
          "transaction_date"
        ],
        "title": "TransactionRead"
      },
      "TransactionType": {
        "type": "string",
        "enum": [
          "buy",
          "sell"
        ],
        "title": "TransactionType",
        "description": "Transaction actions for portfolio trading."
      },
      "UserCreate": {
        "properties": {
          "user_name": {
            "type": "string",
            "maxLength": 50,
            "title": "User Name"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "user_name",
          "password"
        ],
        "title": "UserCreate"
      },
      "UserLogin": {
        "properties": {
          "user_name": {
            "type": "string",
            "title": "User Name"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "user_name",
          "password"
        ],
        "title": "UserLogin"
      },
      "UserRead": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "user_name": {
            "type": "string",
            "title": "User Name"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "user_name"
        ],
        "title": "UserRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "auth/login"
          }
        }
      }
    }
  }
}
